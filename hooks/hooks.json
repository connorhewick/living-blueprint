{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*[Gg]it[Hh]ub.*",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/scripts/pr_gate.py", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/scripts/pr_gate.py", "timeout": 30 }
        ]
      }
    ]
  }
}
